# BillShield — vendor credentials
#
# Copy to `.env.local` and fill in whatever you have. Nothing here is required:
# every vendor has a working fallback, and the UI always shows which mode each
# stage ran in. Add keys one at a time and watch chips flip from FALLBACK to LIVE.
#
#   cp .env.example .env.local && pnpm doctor

# --- Claude: the judgement layer over the deterministic audit rules ----------
# Without this, the rules engine still finds every structural error on its own.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5.
ANTHROPIC_MODEL=

# --- Nutrient DWS: document intake ------------------------------------------
# Two separate products with two separate keys. The extraction key is the one
# that gives typed line items; the processor key is the OCR fallback.
# Sign up: https://dashboard.nutrient.io
NUTRIENT_DWS_API_KEY=
NUTRIENT_DWS_EXTRACTION_API_KEY=
# DWS_API_BASE_URL=https://api.nutrient.io

# --- SerpApi: live market pricing -------------------------------------------
# https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# --- Doctavian: document generation -----------------------------------------
# Email hello@doctavian.com for credentials, then upload the .docx template and
# put its GUID in DOCTAVIAN_TEMPLATE_URN. Without the URN we render locally.
DOCTAVIAN_API_KEY=
DOCTAVIAN_TEMPLATE_URN=
# DOCTAVIAN_BEARER_TOKEN=
# DOCTAVIAN_BASE_URL=https://api.doctavian.com

# --- Foxit: PDF services + eSign --------------------------------------------
# One gateway for both. Header-pair auth, no token exchange. Both halves needed.
# https://developer-api.foxit.com
FOXIT_CLIENT_ID=
FOXIT_CLIENT_SECRET=
# FOXIT_BASE_URL=https://na1.fusion.foxit.com

# --- Xano: backend of record ------------------------------------------------
# The full API-group base, e.g. https://x8ki-abcd-efgh.n7.xano.io/api:aBC12z98
XANO_API_BASE_URL=
XANO_AUTH_TOKEN=

# --- Demo controls ----------------------------------------------------------
# Force vendors onto their fallback path without removing credentials.
# Comma-separated: nutrient,anthropic,serpapi,doctavian,foxit,xano
DISABLE_VENDORS=
# Per-call timeout before a vendor is considered unavailable (ms).
VENDOR_TIMEOUT_MS=12000
